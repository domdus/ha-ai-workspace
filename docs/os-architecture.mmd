architecture-beta
  group os(server)[Home Assistant OS]
  service ws(server)[AI Workspace] in os
  service core(server)[Home Assistant] in os
  service mcp(server)[MCP] in os
  service runtime(server)[AI Workspace Runtime] in os
  service cloud(internet)[Cursor Cloud]
  ws:R -- L:core
  core:R -- L:mcp
  mcp:R -- L:runtime
  runtime:L --> R:mcp
  runtime:R --> L:cloud
