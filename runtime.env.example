# Not required. Prefer editing docker-compose.runtime.yml.
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Claude Agent SDK (pick one auth mode; see docs/claude-runtime.md)
# OPENROUTER_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# CLAUDE_MODEL=claude-sonnet-5-5
# Required when HOST is not 127.0.0.1. Use the same value on runtime agents → Runtime token.
RUNTIME_TOKEN=
