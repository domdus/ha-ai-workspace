# Not required. Prefer editing docker-compose.runtime.yml.
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Claude SDK agents: a Claude Plan token (claude setup-token) or an Anthropic API key,
# or paste one on each agent. See docs/claude-runtime.md.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# Required when HOST is not 127.0.0.1. Use the same value on runtime agents → Runtime token.
RUNTIME_TOKEN=
